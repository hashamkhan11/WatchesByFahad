NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

NEXT_PUBLIC_WHATSAPP_NUMBER=923XXXXXXXXX
NEXT_PUBLIC_TIKTOK_PIXEL_ID=your_tiktok_pixel_id

# Server-side only — used by netlify/functions/create-order.js and postex.js
# to verify admin tokens and write orders with firebase-admin. Paste the full
# contents of a Firebase service account JSON key as a single-line string.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
NEXT_PUBLIC_SITE_URL=https://watchesbyfahad.com
